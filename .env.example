NODE_ENV=development
DATABASE_URL=postgresql://caab_runtime:change-me-runtime@localhost:5432/caab
DATABASE_ADMIN_URL=postgresql://postgres:change-me@localhost:5432/caab
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Outside localhost, use the public HTTPS panel origin (no path/query/fragment).
S3_ENDPOINT=http://localhost:9000
# Optional browser-facing S3 API endpoint, when S3_ENDPOINT is private/internal.
# S3_PUBLIC_ENDPOINT=https://files.example.test
# Signatures use this host directly: do not replace the host after signing.
S3_REGION=us-east-1
S3_ACCESS_KEY=caab-local
S3_SECRET_KEY=replace-me
S3_QUARANTINE_BUCKET=caab-quarantine
S3_PRIVATE_BUCKET=caab-private
S3_PUBLIC_BUCKET=caab-public
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
# Local tests only. Outside localhost use MAIL_MODE=smtp, real SMTP credentials,
# MAIL_FROM and a public HTTPS BETTER_AUTH_URL. See specs/006-account-settings/quickstart.md.
MAIL_MODE=local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Public environments: MAIL_MODE=smtp, SMTP_HOST, SMTP_PORT, SMTP_USER,
# SMTP_PASSWORD and MAIL_FROM. Do not set E2E_TEST_MODE on a deployed site.
# Full domain/repository migration guide: docs/DEPLOYMENT-CONFIG-AUDIT.md
